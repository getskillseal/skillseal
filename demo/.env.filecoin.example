# Run Act 5 against real distributed, S3-compatible Filecoin storage.
# The demo code is unchanged; Filecoin is a configuration.
#
#   set -a; . ./.env.filecoin.example; set +a
#   node demo/skill-tree/skill-tree.mjs encode examples/document/pdf-fill
#   node client/run-s3.mjs
#
# Pick ONE provider block and fill in credentials from that provider's console.

# --- Akave O3 (Filecoin's S3 layer: hot data + cold Filecoin deals) ---
# Endpoint is per-credential; copy it from https://console.akave.com/
# S3_PROVIDER=akave
# S3_ENDPOINT=https://<your-endpoint>.akave.xyz
# S3_REGION=akave-network
# S3_BUCKET=kappa-blobs
# S3_ACCESS_KEY=<your-access-key>
# S3_SECRET_KEY=<your-secret-key>

# --- Filebase (IPFS + Filecoin; returns the object's IPFS CID) ---
# Keys from https://console.filebase.com/
# S3_PROVIDER=filebase
# S3_ENDPOINT=https://s3.filebase.com
# S3_REGION=us-east-1
# S3_BUCKET=<your-bucket>
# S3_ACCESS_KEY=<your-access-key>
# S3_SECRET_KEY=<your-secret-key>

# --- Storj (decentralized, S3-compatible) ---
# S3_PROVIDER=storj
# S3_ENDPOINT=https://gateway.storjshare.io
# S3_BUCKET=<your-bucket>
# S3_ACCESS_KEY=<your-access-key>
# S3_SECRET_KEY=<your-secret-key>
